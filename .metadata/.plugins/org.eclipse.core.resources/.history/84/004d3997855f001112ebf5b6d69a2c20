spring.application.name=servicio-productos
server.port=8081

# Configuración de Eureka (el puerto 8761 que les dio el profesor)
eureka.client.service-url.defaultZone=http://localhost:8761/eureka/

# Configuración de tu base de datos MySQL
spring.datasource.url=jdbc:mysql://localhost:3306/la_bodeguita_db?useSSL=false&serverTimezone=UTC
spring.datasource.username=tu_usuario
spring.datasource.password=tu_contraseña

# Para que Hibernate no nos borre las tablas, sino que las valide o actualice
spring.jpa.hibernate.ddl-auto=update
spring.jpa.show-sql=true