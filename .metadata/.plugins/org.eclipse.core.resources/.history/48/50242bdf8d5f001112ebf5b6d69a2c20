package com.productos.repository;

import java.util.List;

import org.springframework.data.jpa.repository.JpaRepository;
import org.springframework.stereotype.Repository;

import com.productos.model.Categoria;

@Repository
public interface ICategoriarRepository extends JpaRepository<Categoria, Integer> {
    // Listar por Nombre
    List<Categoria> findByNombreContainingIgnoreCase(String nombre);
    
    // Listar por Estado
    List<Categoria> findByEstadoCateg(Boolean estadoCateg);
    
    // Listar de forma Ascendente (por nombre)
    List<Categoria> findByOrderByNombreAsc();
    
    // Listar de forma Descendente (por nombre)
    List<Categoria> findByOrderByNombreDesc();
}
