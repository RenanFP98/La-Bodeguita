server.port=8081
spring.application.name=servicio-productos

# Configuración de Eureka (el puertito del profesor)
eureka.client.service-url.defaultZone=http://localhost:8761/eureka/

# Configuración de tu base de datos MySQL (¡Ya con tus datitos!)
spring.datasource.url=jdbc:mysql://localhost:3306/la_bodeguita_db?useSSL=false&serverTimezone=UTC
spring.datasource.username=root
spring.datasource.password=mysql

# Para que nuestras tablitas se actualicen bonito sin borrarse
spring.jpa.hibernate.ddl-auto=update
spring.jpa.show-sql=true