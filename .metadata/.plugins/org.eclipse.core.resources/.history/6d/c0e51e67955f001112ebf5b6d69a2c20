package com.productos.feign;

import org.springframework.cloud.openfeign.FeignClient;
import org.springframework.web.bind.annotation.GetMapping;
import org.springframework.web.bind.annotation.PathVariable;

//Tiene que llamarse igualito a como lo nombramos en el application.properties del otro proyecto
@FeignClient(name = "servicio-proveedores")
public interface ProveedorClient {
 
 // Hacemos la misma ruta que tu compañero y tú hicieron en el ProveedorController
 @GetMapping("/api/proveedores/{id}")
 ProveedorDTO obtenerProveedorPorId(@PathVariable("id") Integer id);
}
