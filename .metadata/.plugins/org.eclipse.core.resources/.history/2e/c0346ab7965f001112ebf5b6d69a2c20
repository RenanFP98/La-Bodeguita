server.port=8081
spring.application.name=servicio-productos

# Configuracion de Eureka
eureka.client.service-url.defaultZone=http://localhost:8761/eureka/

# Configuracion de tu base de datos MySQL
spring.datasource.url=jdbc:mysql://localhost:3306/la_bodeguita_db?useSSL=false&serverTimezone=UTC
spring.datasource.username=root
spring.datasource.password=mysql

# Para que las tablas se actualicen sin borrarse
spring.jpa.hibernate.ddl-auto=update
spring.jpa.show-sql=true

# --- CONFIGURACION PARA QUE SE RECONOZCAN MAS RAPIDO ---

# Le decimos a Eureka que actualice su lista cada 5 segundos (por defecto son 30)
eureka.client.registry-fetch-interval-seconds=5

# El microservicio "latira" cada 5 segundos para decir "¡Sigo aqui!"
eureka.instance.lease-renewal-interval-in-seconds=5

# Si pasan 10 segundos sin latir, Eureka sabrá que se apago
eureka.instance.lease-expiration-duration-in-seconds=10