server.port=8083
spring.application.name=servicio-empleados

# Configuracion de Eureka
eureka.client.service-url.defaultZone=http://localhost:8761/eureka/
eureka.client.registry-fetch-interval-seconds=5
eureka.instance.lease-renewal-interval-in-seconds=5
eureka.instance.lease-expiration-duration-in-seconds=10

# Configuracion de MySQL
spring.datasource.url=jdbc:mysql://localhost:3306/la_bodeguita_db?useSSL=false&serverTimezone=UTC
spring.datasource.username=root
spring.datasource.password=mysql

spring.jpa.hibernate.ddl-auto=update
spring.jpa.show-sql=true

# --- CONFIGURACION PARA QUE SE RECONOZCAN MAS RAPIDO ---

# Le decimos a Eureka que actualice su lista cada 5 segundos
eureka.client.registry-fetch-interval-seconds=5

# El microservicio latira cada 5 segundos para decir que sigue aqui
eureka.instance.lease-renewal-interval-in-seconds=5

# Si pasan 10 segundos sin latir, Eureka sabra que se apago
eureka.instance.lease-expiration-duration-in-seconds=10