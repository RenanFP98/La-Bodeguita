server.port=8084
spring.application.name=servicio-reposiciones

# Configuracion de Eureka
eureka.client.service-url.defaultZone=http://localhost:8761/eureka/
eureka.client.registry-fetch-interval-seconds=5
eureka.instance.lease-renewal-interval-in-seconds=5
eureka.instance.lease-expiration-duration-in-seconds=10

# Configuracion de tu base de datos MySQL
spring.datasource.url=jdbc:mysql://localhost:3306/la_bodeguita_db?useSSL=false&serverTimezone=UTC
spring.datasource.username=root
spring.datasource.password=mysql

spring.jpa.hibernate.ddl-auto=update
spring.jpa.show-sql=true