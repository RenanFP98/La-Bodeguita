package com.empleados.service;

import java.util.List;
import java.util.Optional;

import org.springframework.beans.factory.annotation.Autowired;
import org.springframework.stereotype.Service;

import com.empleados.model.Empleado;
import com.empleados.repository.IEmpleadoRepository;

@Service
public class EmpleadoService {

    @Autowired
    private IEmpleadoRepository empleadoRepository;

    public Empleado guardarEmpleado(Empleado empleado) {
        // Más adelante, aquí encriptaremos la contraseña antes de guardarla
        return empleadoRepository.save(empleado);
    }

    public Empleado actualizarEmpleado(Integer id, Empleado empleadoActualizado) {
        return empleadoRepository.findById(id).map(empleado -> {
            empleado.setUsername(empleadoActualizado.getUsername());
            empleado.setNomUsua(empleadoActualizado.getNomUsua());
            empleado.setApellUsua(empleadoActualizado.getApellUsua());
            empleado.setContrasena(empleadoActualizado.getContrasena());
            empleado.setDni(empleadoActualizado.getDni());
            empleado.setRol(empleadoActualizado.getRol());
            return empleadoRepository.save(empleado);
        }).orElse(null);
    }

    public boolean eliminarLogicoEmpleado(Integer id) {
        Optional<Empleado> empleadoOpt = empleadoRepository.findById(id);
        if (empleadoOpt.isPresent()) {
            Empleado empleado = empleadoOpt.get();
            empleado.setEstadoUsua(false);
            empleadoRepository.save(empleado);
            return true;
        }
        return false;
    }

    public List<Empleado> listarTodos() {
        return empleadoRepository.findAll();
    }
}
